{
  "name": "scientific-calculator-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:help": "bun run scripts/render-help.ts",
    "dev": "bun run generate:help && bun --bun vite",
    "build": "bun run generate:help && tsc -b && bun --bun vite build",
    "lint": "oxlint",
    "test": "bun run generate:help && bun --bun vitest",
    "test:run": "bun run generate:help && bun test tests/bun && bun --bun vitest run",
    "typecheck": "tsc -b --pretty false",
    "preview": "bun --bun vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "pyodide": "^314.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
