{
  "name": "scientific-calculator-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:help": "bun run scripts/render-help.ts",
    "generate:solver": "bun run scripts/render-solver-source.ts",
    "generate:worker": "bun run scripts/render-solver-worker.ts",
    "generate:css": "bunx @tailwindcss/cli -i preview/globals.css -o preview/generated.css --minify",
    "generate:assets": "bun run generate:help && bun run generate:solver && bun run generate:worker",
    "dev": "bun run generate:assets && bun run generate:css && bun preview/index.html --console",
    "build": "bun run generate:assets && bun run generate:css && bun run typecheck && bun build preview/index.html --minify --outdir dist",
    "lint": "oxlint",
    "test": "bun run generate:assets && vitest",
    "test:run": "bun run generate:assets && bun test tests/bun && vitest run",
    "typecheck": "tsc --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "pyodide": "^314.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
